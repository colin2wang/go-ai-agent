{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/api/health": {
            "get": {
                "description": "服务存活探测",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "健康检查",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/jobs/{id}": {
            "get": {
                "description": "按 jobID 查询一次审读的结果（当前实现为同步接口，此端点预留异步扩展）",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "jobs"
                ],
                "summary": "查询任务结果",
                "parameters": [
                    {
                        "type": "string",
                        "description": "任务 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.JobResult"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.apiError"
                        }
                    }
                }
            }
        },
        "/api/payslip/review": {
            "post": {
                "description": "multipart/form-data 上传工资单图片（字段名 file），同步执行 OCR→翻译→审读→专家→汇总，返回完整报告",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "payslip"
                ],
                "summary": "上传工资单并执行审读流水线",
                "parameters": [
                    {
                        "type": "file",
                        "description": "工资单图片（PNG/JPG）",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.JobResult"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.apiError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.apiError"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "api.JobResult": {
            "type": "object",
            "properties": {
                "duration_ms": {
                    "type": "integer"
                },
                "error": {
                    "type": "string"
                },
                "final_report": {
                    "type": "string"
                },
                "job_id": {
                    "type": "string"
                },
                "ocr_text": {
                    "type": "string"
                },
                "review_notes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "status": {
                    "description": "processing | done | failed",
                    "type": "string"
                },
                "structured": {
                    "type": "object",
                    "additionalProperties": {}
                },
                "translation": {
                    "type": "string"
                }
            }
        },
        "api.apiError": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "error message"
                }
            }
        }
    }
}